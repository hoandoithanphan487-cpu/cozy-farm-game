; Engine configuration file.
; Engine version and Compatibility renderer are locked by P0-001.
; M1-001 adds a placeholder farm slice while preserving the M0 InputMap baseline.
config_version=5

[application]

config/name="溪谷新芽"
config/features=PackedStringArray("4.7", "GL Compatibility")
